  "probability/eq-19.svg": {
    "tag": "P19",
    "latex": "p_\\theta(z\\mid x)\n=\\frac{p(z)p_\\theta(x\\mid z)}\n{\\int p(z')p_\\theta(x\\mid z')\\,dz'}.\n\\tag{P19}",
