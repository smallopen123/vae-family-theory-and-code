  },
  "probability/eq-21.svg": {
    "tag": "P21",
    "latex": "\\log p_\\theta(x)\n=\\mathcal L(\\theta,\\phi;x)\n+D_{\\mathrm{KL}}\\!\\left(\nq_\\phi(z\\mid x)\\,\\|\\,p_\\theta(z\\mid x)\\right).\n\\tag{P21}",
    "rows": [
      "\\log p_\\theta(x) =\\mathcal{L}(\\theta,\\phi;x) +D_{\\mathrm{KL}}\\!\\left( q_\\phi(z\\mid x)\\,\\|\\,p_\\theta(z\\mid x)\\right)."
    ]
  },
  "probability/eq-22.svg": {
