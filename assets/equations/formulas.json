    ]
  },
  "probability/eq-23.svg": {
    "tag": "P23",
    "latex": "\\mathcal L(\\theta,\\phi;x)\n=\\mathbb E_{q_\\phi(z\\mid x)}\n[\\log p_\\theta(x\\mid z)]\n-D_{\\mathrm{KL}}\\!\\left(q_\\phi(z\\mid x)\\,\\|\\,p(z)\\right).\n\\tag{P23}",
    "rows": [
      "\\mathcal{L}(\\theta,\\phi;x) =\\mathbb{E}_{q_\\phi(z\\mid x)} [\\log p_\\theta(x\\mid z)] -D_{\\mathrm{KL}}\\!\\left(q_\\phi(z\\mid x)\\,\\|\\,p(z)\\right)."
    ]
  },
  "probability/eq-24.svg": {
    "tag": "P24",
    "latex": "\\mathrm{loss}\n=-\\mathcal L\n=\\underbrace{-\\mathbb E_q[\\log p_\\theta(x\\mid z)]}_{\\text{重构负对数似然}}\n+\\underbrace{D_{\\mathrm{KL}}(q_\\phi(z\\mid x)\\|p(z))}_{\\text{KL 正则}}.\n\\tag{P24}",
    "rows": [
      "\\mathrm{loss} =-\\mathcal{L} =-\\mathbb{E}_q[\\log p_\\theta(x\\mid z)] +D_{\\mathrm{KL}}(q_\\phi(z\\mid x)\\|p(z))."
    ]
  },
  "probability/eq-25.svg": {
