  "probability/eq-18.svg": {
    "tag": "P18",
    "latex": "\\sum_{i=1}^{N}\\log p_\\theta(x_i)\n=\\sum_{i=1}^{N}\\log\\int p(z_i)p_\\theta(x_i\\mid z_i)\\,dz_i.\n\\tag{P18}",
