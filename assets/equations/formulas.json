  "probability/eq-05.svg": {
    "tag": "P5",
    "latex": "p(x,z)=p(z)\\,p(x\\mid z)=p(x)\\,p(z\\mid x).\n\\tag{P5}",
    "rows": [
      "p(x,z)=p(z)\\,p(x\\mid z)=p(x)\\,p(z\\mid x)."
    ]
  },
  "probability/eq-06.svg": {
    "tag": "P6",
    "latex": "\\begin{aligned}\np(x=1)\n&=\\sum_z p(x=1,z)\\\\\n&=p(z=0)p(x=1\\mid z=0)+p(z=1)p(x=1\\mid z=1)\\\\\n&=0.6\\times0.2+0.4\\times0.9\\\\\n&=0.48.\n\\end{aligned}\n\\tag{P6}",
    "rows": [
      "p(x=1) =\\sum_z p(x=1,z)",
      "=p(z=0)p(x=1\\mid z=0)+p(z=1)p(x=1\\mid z=1)",
      "=0.6\\times0.2+0.4\\times0.9",
      "=0.48."
    ]
  },
  "probability/eq-07.svg": {
    "tag": "P7",
    "latex": "p_\\theta(x)=\\int p_\\theta(x,z)\\,dz\n=\\int p(z)\\,p_\\theta(x\\mid z)\\,dz.\n\\tag{P7}",
    "rows": [
      "p_\\theta(x)=\\int p_\\theta(x,z)\\,dz =\\int p(z)\\,p_\\theta(x\\mid z)\\,dz."
    ]
  },
  "probability/eq-08.svg": {
    "tag": "P8",
    "latex": "\\begin{aligned}\np(z=1\\mid x=1)\n&=\\frac{p(x=1,z=1)}{p(x=1)}\\\\\n&=\\frac{p(z=1)p(x=1\\mid z=1)}{p(x=1)}\\\\\n&=\\frac{0.4\\times0.9}{0.48}=0.75.\n\\end{aligned}\n\\tag{P8}",
    "rows": [
      "p(z=1\\mid x=1) =\\frac{p(x=1,z=1)}{p(x=1)}",
      "=\\frac{p(z=1)p(x=1\\mid z=1)}{p(x=1)}",
      "=\\frac{0.4\\times0.9}{0.48}=0.75."
    ]
  },
  "probability/eq-09.svg": {
    "tag": "P9",
    "latex": "\\mathbb E_{p(z)}[f(z)]\n=\\sum_z p(z)f(z)\n=0.6\\times10+0.4\\times30=18.\n\\tag{P9}",
    "rows": [
      "\\mathbb{E}_{p(z)}[f(z)] =\\sum_z p(z)f(z) =0.6\\times10+0.4\\times30=18."
    ]
  },
  "probability/eq-10.svg": {
    "tag": "P10",
    "latex": "\\mathbb E_{p(z\\mid x=1)}[f(z)]\n=0.25\\times10+0.75\\times30=25.\n\\tag{P10}",
    "rows": [
      "\\mathbb{E}_{p(z\\mid x=1)}[f(z)] =0.25\\times10+0.75\\times30=25."
    ]
  },
  "probability/eq-11.svg": {
    "tag": "P11",
    "latex": "\\mathbb E_{q_\\phi(z\\mid x)}[f(z)]\n=\\int q_\\phi(z\\mid x)\\,f(z)\\,dz.\n\\tag{P11}",
    "rows": [
