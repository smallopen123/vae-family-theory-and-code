  "probability/eq-12.svg": {
    "tag": "P12",
    "latex": "\\mathbb E_{q_\\phi(z\\mid x)}[f(z)]\n\\approx \\frac1L\\sum_{\\ell=1}^{L}f(z^{(\\ell)}),\n\\qquad z^{(\\ell)}\\sim q_\\phi(z\\mid x).\n\\tag{P12}",
    "rows": [
